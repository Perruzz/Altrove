    <!-- One-time setup -->
    <string name="setup_title">One-time setup</string>
    <string name="setup_mock_body">Android only lets the app picked as “mock location app” move the device position. Open Developer options and select Altrove.</string>
    <string name="setup_mock_action">Open Developer options</string>
    <!-- Followed by setup_developer_link, which ends the sentence as a tappable link. -->
    <string name="setup_developer_hint">No Developer options on your phone? Turn them on first: tap “Build number” seven times in</string>
    <string name="setup_developer_link">Settings › About phone</string>
    <string name="setup_permissions_both">Two optional permissions make it better. Notifications show the countdown. Location access lets Google Play services hold your spot steadily in apps like Google Maps: Altrove itself never reads your real position.</string>
    <string name="setup_permissions_notifications">Optional: allow notifications to see the countdown and stop a session from anywhere.</string>
    <string name="setup_permissions_location">Optional: allow location access so Google Play services holds your spot steadily in apps like Google Maps. Altrove itself never reads your real position.</string>
    <string name="setup_permissions_action">Allow</string>
    <string name="setup_permissions_skip">Not now</string>

    <!-- Session -->
    <string name="status_idle_title">Real position</string>
    <string name="status_idle_body">Tap the widget on your home screen to be at your destination for 5 minutes.</string>
    <string name="status_idle_body_no_destination">Choose a destination first.</string>
    <string name="status_idle_body_setup">Finish the setup above first.</string>
    <string name="status_active_title">You are elsewhere</string>
